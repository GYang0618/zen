{
  "name": "@zen/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zen-plugin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/generated/plugin-registry.gen.d.ts",
      "default": "./dist/generated/plugin-registry.gen.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node ./dist/cli.js validate",
    "generate": "node ./dist/cli.js generate"
  },
  "dependencies": {
    "@zen/shared": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
