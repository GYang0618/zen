{
  "name": "@zen/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zen-plugin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/generated/plugin-registry.gen.d.ts",
      "default": "./dist/generated/plugin-registry.gen.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node ./dist/cli.js validate",
    "generate": "node ./dist/cli.js generate"
  },
  "dependencies": {
    "@zen/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
