{
  "name": "@zen/plugin-registry",
  "version": "0.1.0",
  "private": true,
  "description": "编译期插件聚合层：catalog / api / web / config / lifecycle",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js",
      "browser": "./src/index.ts"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js",
      "browser": "./src/catalog.ts"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js",
      "browser": "./src/api.ts"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js",
      "browser": "./src/web.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js",
      "browser": "./src/config.ts"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js",
      "browser": "./src/lifecycle.ts"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js",
      "browser": "./src/agent.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@zen/plugin-demo-notes": "workspace:*",
    "@zen/plugin-jobs": "workspace:*",
    "@zen/plugin-notifications": "workspace:*",
    "@zen/plugin-sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
