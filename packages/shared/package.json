      "default": "./dist/domains/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "browser": "./src/agent/index.ts",
      "default": "./dist/agent/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
