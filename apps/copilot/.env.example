# LangGraph Platform（CopilotKit Runtime 连接 LangGraph Agent）
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
LANGGRAPH_GRAPH_ID=langchain_agent

# Qwen 思考区：middleware = 与 agent.ts 中 Qwen 中间件搭配（默认）；
# runtime = 使用 RuntimeQwenReasoningLangGraphAgent，此时请把 agent.ts 的 middleware 改成仅 copilotkitMiddleware
# COPILOTKIT_QWEN_REASONING_MODE=middleware

# OpenAI配置
OPENAI_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
