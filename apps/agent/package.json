    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.1",
    "@langchain/langgraph-checkpoint": "^1.0.2",
    "@langchain/openai": "^1.4.4",
    "@zen/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "langchain": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.2",
    "@langchain/langgraph-cli": "^1.2.2",
    "@types/node": "^25.7.0",
