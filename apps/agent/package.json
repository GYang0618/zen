{
  "name": "agent",
  "type": "module",
  "scripts": {
    "openapi:generate": "openapi-ts -f openapi-ts.config.ts",
    "prebuild": "pnpm run openapi:generate",
    "predev": "pnpm run openapi:generate",
    "dev": "langgraphjs dev --port 3600 --host 127.0.0.1 --no-browser",
    "service": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@copilotkit/runtime": "^1.63.2",
    "@copilotkit/sdk-js": "^1.63.2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hono/node-server": "^2.0.11",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "@zen/shared": "workspace:*",
    "deepagents": "^1.11.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "langchain": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@langchain/langgraph-cli": "^1.4.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
