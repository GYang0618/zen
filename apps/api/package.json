  "scripts": {
    "prebuild": "pnpm -F @zen/shared build && pnpm -F @zen/plugin-sdk build && pnpm --filter '@zen/plugin-demo-notes' --filter '@zen/plugin-jobs' --filter '@zen/plugin-notifications' build && pnpm run prisma:generate",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "pnpm run test --watch",
    "test:cov": "pnpm run test --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "pnpm run test --config ./test/jest-e2e.config.mjs",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev"
  },
