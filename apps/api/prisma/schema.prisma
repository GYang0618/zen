generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 性别枚举
enum Gender {
  /// 男
  MALE    @map("male")
  /// 女
  FEMALE  @map("female")
  /// 未知
  UNKNOWN @map("unknown")
}

/// 多因子认证类型枚举
enum MfaType {
  /// TOTP 动态口令
  TOTP  @map("totp")
  /// 短信验证码
  SMS   @map("sms")
  /// 邮箱验证码
  EMAIL @map("email")
  /// 关闭多因子认证
  OFF   @map("off")
}

/// 主题模式枚举
enum Theme {
  /// 浅色模式
  LIGHT  @map("light")
  /// 深色模式
  DARK   @map("dark")
  /// 跟随系统
  SYSTEM @map("system")
}

/// 通用记录状态枚举
enum RecordStatus {
  /// 启用
  ACTIVE   @map("active")
  /// 禁用
  DISABLED @map("disabled")
}

/// 角色种类
enum RoleKind {
  /// 系统角色（锁定）
  SYSTEM @map("system")
  /// 自定义角色
  CUSTOM @map("custom")
}

/// 权限目录状态
enum PermissionStatus {
  /// 可用
  ACTIVE     @map("active")
  /// 已下线
  DEPRECATED @map("deprecated")
}

/// 字段权限访问级别（预留）
enum FieldAccess {
  NONE   @map("none")
  MASKED @map("masked")
  READ   @map("read")
  WRITE  @map("write")
}

/// 角色数据范围枚举
enum RoleDataScope {
  /// 全部数据
  ALL               @map("all")
  /// 组织及下级
  ORGANIZATION      @map("organization")
  /// 仅本组织（不含下级）
  ORGANIZATION_ONLY @map("organization_only")
  /// 仅本人数据
  SELF              @map("self")
  /// 自定义数据范围
  CUSTOM            @map("custom")
}

/// 用户账号状态枚举
enum UserStatusCode {
  /// 激活
  ACTIVE    @map("active")
  /// 未激活
  INACTIVE  @map("inactive")
  /// 待审核
  PENDING   @map("pending")
  /// 已停用
  SUSPENDED @map("suspended")
}

/// 组织类型枚举
enum OrganizationType {
  /// 集团
  GROUP      @map("group")
  /// 公司
  COMPANY    @map("company")
  /// 事业部
  DIVISION   @map("division")
  /// 分支机构
  BRANCH     @map("branch")
  /// 中心
  CENTER     @map("center")
  /// 部门
  DEPARTMENT @map("department")
  /// 团队
  TEAM       @map("team")
  /// 项目组
  PROJECT    @map("project")
}

/// 岗位目录状态
enum JobProfileStatus {
  /// 启用
  ACTIVE   @map("active")
  /// 停用
  DISABLED @map("disabled")
}

/// 组织岗位编制状态
enum OrganizationPositionStatus {
  /// 启用
  ACTIVE @map("active")
  /// 冻结
  FROZEN @map("frozen")
}

/// 租户表（单租户交付阶段仅种子 default；全链路 Context 必带 tenantId）
model Tenant {
  /// 租户 ID
  id        String       @id @default(cuid())
  /// 租户编码
  code      String       @unique
  /// 租户名称
  name      String
  /// 状态
  status    RecordStatus @default(ACTIVE)
  /// 租户级配置
  settings  Json?
  /// 创建时间
  createdAt DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@map("tenants")
}

/// Default Agent 对话线程。Popup/plan_agent 不写入该表。
model AgentThread {
  id            String   @id
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  agentId       String   @default("default_agent") @map("agent_id")
  title         String?
  status        String   @default("active")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  runs       AgentRun[]
  messages   AgentMessage[]
  checkpoints AgentCheckpoint[]
  memories   AgentMemory[]

  @@index([tenantId, userId, updatedAt])
  @@index([tenantId, agentId, status])
  @@map("agent_threads")
}

/// 一次模型执行；runId 直接复用 AG-UI runId，便于端到端追踪。
model AgentRun {
  id             String   @id
  threadId       String   @map("thread_id")
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  agentId        String   @default("default_agent") @map("agent_id")
  status         String   @default("pending")
  endReason      String?  @map("end_reason")
  budget         Json
  error          Json?
  eventSequence  Int      @default(0) @map("event_sequence")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  modelCalls     Int      @default(0) @map("model_calls")
  failureCount   Int      @default(0) @map("failure_count")
  traceId        String?  @map("trace_id")
  modelVersion   String?  @map("model_version")
  promptVersion  String?  @map("prompt_version")
  toolSchemaVersion String? @map("tool_schema_version")
  firstTokenAt   DateTime? @map("first_token_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  leaseOwner     String?  @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  resumeCount    Int      @default(0) @map("resume_count")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  thread         AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turns          AgentTurn[]
  events         AgentEvent[]
  approvals      AgentApproval[]
  toolExecutions AgentToolExecution[]
  evaluations    AgentEvaluation[]
  artifacts      AgentArtifact[]

  @@index([tenantId, userId, createdAt])
  @@index([threadId, createdAt])
  @@index([status, updatedAt])
  @@index([leaseExpiresAt])
  @@map("agent_runs")
}

/// 当前实现中一次 AG-UI Run 对应一个 Turn；模型允许后续扩展为多 Turn Run。
model AgentTurn {
  id        String   @id
  runId     String   @map("run_id")
  tenantId  String   @map("tenant_id")
  sequence  Int      @default(0)
  status    String   @default("pending")
  endReason String?  @map("end_reason")
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run      AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@unique([runId, sequence])
  @@index([tenantId, createdAt])
  @@map("agent_turns")
}

/// 可回传模型的规范消息。reasoning/activity 仅存 AgentEvent。
model AgentMessage {
  id         String   @id
  threadId   String   @map("thread_id")
  turnId     String?  @map("turn_id")
  tenantId   String   @map("tenant_id")
  sequence   Int
  role       String
  content    String   @default("")
  toolCallId String?  @map("tool_call_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turn   AgentTurn?  @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@unique([threadId, sequence])
  @@index([tenantId, threadId, createdAt])
  @@index([toolCallId])
  @@map("agent_messages")
}

/// 可按 sequence 游标重放的 AG-UI 事件日志。
model AgentEvent {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  threadId  String   @map("thread_id")
  tenantId  String   @map("tenant_id")
  sequence  Int
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([tenantId, threadId, sequence])
  @@index([runId, type])
  @@map("agent_events")
}

/// 会话状态快照；reasoning/activity 会在写入前过滤。
model AgentCheckpoint {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  runId     String   @map("run_id")
  tenantId  String   @map("tenant_id")
  version   Int
  state     Json
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, version])
  @@index([tenantId, threadId, createdAt])
  @@map("agent_checkpoints")
}

/// 高风险 Tool 的人工审批记录。
model AgentApproval {
  id            String   @id @default(cuid())
  runId         String   @map("run_id")
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  toolCallId    String   @map("tool_call_id")
  interruptId   String   @map("interrupt_id")
  toolName      String   @map("tool_name")
  operation     String?
  targetSummary String?  @map("target_summary")
  impactSummary String?  @map("impact_summary")
  riskLevel     String?  @map("risk_level")
  parameterSummary String? @map("parameter_summary")
  arguments     Json
  argumentsHash String   @map("arguments_hash")
  status        String   @default("pending")
  decision      String?
  reason        String?
  decidedBy     String?  @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId])
  @@unique([runId, interruptId])
  @@index([tenantId, userId, status, createdAt])
  @@map("agent_approvals")
}

/// Tool 执行账本；idempotencyKey 防止重连或重试造成重复写入。
model AgentToolExecution {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  tenantId       String   @map("tenant_id")
  toolCallId     String   @map("tool_call_id")
  toolName       String   @map("tool_name")
  permissionCode String?  @map("permission_code")
  riskLevel      String?  @map("risk_level")
  sideEffect     String?  @map("side_effect")
  traceId        String?  @map("trace_id")
  idempotencyKey String   @map("idempotency_key")
  arguments      Json?
  result         Json?
  status         String   @default("pending")
  attempt        Int      @default(1)
  errorReason    String?  @map("error_reason")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifacts AgentArtifact[]

  @@unique([tenantId, idempotencyKey])
  @@unique([runId, toolCallId])
  @@index([tenantId, toolName, status, createdAt])
  @@map("agent_tool_executions")
}

/// Tool 大结果或可独立查看的运行产物。
model AgentArtifact {
  id              String   @id @default(cuid())
  runId           String   @map("run_id")
  threadId        String   @map("thread_id")
  tenantId        String   @map("tenant_id")
  userId          String   @map("user_id")
  toolExecutionId String?  @map("tool_execution_id")
  kind            String
  name            String
  mimeType        String   @default("application/json") @map("mime_type")
  size            Int
  summary         String?
  content         Json?
  storageKey      String?  @map("storage_key")
  status          String   @default("available")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolExecution AgentToolExecution? @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, createdAt])
  @@index([runId, createdAt])
  @@index([threadId, createdAt])
  @@map("agent_artifacts")
}

/// 显式写入的用户/线程记忆；不自动保存敏感 Tool 参数。
model AgentMemory {
  id        String   @id @default(cuid())
  threadId  String?  @map("thread_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  scope     String
  kind      String
  key       String
  content   Json
  sensitivity String  @default("private")
  shareWithModel Boolean @default(false) @map("share_with_model")
  modelProvider String? @map("model_provider")
  approvedForModelAt DateTime? @map("approved_for_model_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  thread AgentThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, scope, key])
  @@index([tenantId, userId, expiresAt])
  @@map("agent_memories")
}

/// 离线或人工评测结果，不进入在线模型上下文。
model AgentEvaluation {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  tenantId  String   @map("tenant_id")
  evaluator String
  metric    String
  score     Float
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, evaluator, metric])
  @@index([tenantId, metric, createdAt])
  @@map("agent_evaluations")
}

/// Agent 写请求的 API 级幂等结果；按租户与用户隔离，在业务 Controller 前去重。
model AgentIdempotencyRecord {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  key         String
  requestHash String   @map("request_hash")
  status      String   @default("running")
  response    Json?
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, key])
  @@index([expiresAt])
  @@map("agent_idempotency_records")
}

/// 操作审计日志
model AuditLog {
  /// 审计 ID
  id         String   @id @default(cuid())
  /// 租户 ID
  tenantId   String   @map("tenant_id")
  /// 操作者用户 ID
  actorId    String?  @map("actor_id")
  /// 动作编码（如 system.user.created）
  action     String
  /// 资源类型
  resource   String?
  /// 资源 ID
  resourceId String?  @map("resource_id")
  /// 客户端 IP
  ip         String?
  /// User-Agent
  userAgent  String?  @map("user_agent")
  /// 请求追踪 ID
  traceId    String?  @map("trace_id")
  /// 变更摘要
  diff       Json?
  /// 创建时间
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([traceId])
  @@map("audit_logs")
}

/// 租户成员资格（单租户阶段每个用户一条 default 成员记录）
model Membership {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  userId    String       @map("user_id")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// 插件安装状态
enum PluginInstallStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

/// 租户内插件安装记录（编译期插件的启停与配置）
model PluginInstallation {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  pluginId  String              @map("plugin_id")
  version   String
  status    PluginInstallStatus @default(ACTIVE)
  config    Json?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, pluginId])
  @@index([tenantId, status])
  @@index([pluginId])
  @@map("plugin_installations")
}

/// 登录会话（Refresh Token 服务端实体，支持多设备与强制下线）
model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  tenantId         String    @map("tenant_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// 用户主表
model User {
  /// 用户ID
  id            String         @id @default(cuid())
  /// 用户名
  username      String         @unique
  /// 昵称
  nickname      String?
  /// 邮箱
  email         String         @unique
  /// 手机号码
  phoneNumber   String?        @unique @map("phone_number")
  /// 密码哈希
  password      String
  /// 账号状态
  status        UserStatusCode @default(ACTIVE)
  /// 登录失败次数
  loginAttempts Int            @default(0)
  /// 是否锁定
  isLocked      Boolean        @default(false)
  /// 锁定到期时间
  lockExpireAt  DateTime?
  /// 创建时间
  createdAt     DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// 软删除时间（null 表示未删除）
  deletedAt     DateTime?      @map("deleted_at")

  /// 用户资料（一对一）
  profile             UserProfile?
  /// 用户安全设置（一对一）
  security            UserSecurity?
  /// 用户偏好设置（一对一）
  preference          UserPreference?
  /// 用户审计信息（一对一）
  audit               UserAudit?
  /// 用户角色关联（一对多）
  roles               UserRole[]
  /// 租户成员资格
  memberships         Membership[]
  /// 登录会话
  sessions            Session[]
  /// 密码重置令牌
  passwordResetTokens PasswordResetToken[]
  /// 登录事件
  loginEvents         LoginEvent[]
  /// 站内通知
  notifications       Notification[]
  /// 上传文件
  fileAssets          FileAsset[]
  /// 用户组织岗位关联（一对多）
  organizations       UserOrganization[]
  /// 负责的组织集合（一对多）
  ledOrganizations    Organization[]       @relation("OrganizationLeader")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

/// 用户资料表
model UserProfile {
  /// 资料ID
  id        String   @id @default(cuid())
  /// 用户ID
  userId    String   @unique @map("user_id")
  /// 真实姓名
  realName  String?  @map("real_name")
  /// 头像地址
  avatar    String?
  /// 性别
  gender    Gender   @default(UNKNOWN)
  /// 出生日期
  birthday  DateTime? @db.Date
  /// 职位名称
  jobTitle  String?  @map("job_title")
  /// 备注
  remark    String?
  /// 扩展元数据
  meta      Json?
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
  @@map("user_profiles")
}

/// 用户安全设置表
model UserSecurity {
  /// 安全记录ID
  id                 String    @id @default(cuid())
  /// 用户ID
  userId             String    @unique @map("user_id")
  /// 是否开启多因子认证
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  /// 多因子认证类型
  mfaType            MfaType   @default(OFF) @map("mfa_type")
  /// 密码到期时间
  passwordExpireAt   DateTime? @map("password_expire_at")
  /// 上次修改密码时间
  lastPasswordChange DateTime? @map("last_password_change")
  /// 是否必须修改密码（首次登录 / 管理员重置）
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// TOTP 密钥（启用 MFA 后保存）
  mfaSecret          String?   @map("mfa_secret")
  /// 创建时间
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mfaEnabled])
  @@index([mfaType])
  @@map("user_security")
}

/// 用户偏好设置表
model UserPreference {
  /// 偏好记录ID
  id                String   @id @default(cuid())
  /// 用户ID
  userId            String   @unique @map("user_id")
  /// 语言区域
  locale            String   @default("zh-CN")
  /// 时区
  timezone          String   @default("Asia/Shanghai")
  /// 主题模式
  theme             Theme    @default(SYSTEM)
  /// 邮件通知开关
  notifyByEmail     Boolean  @default(true) @map("notify_by_email")
  /// 推送通知开关
  notifyByPush      Boolean  @default(true) @map("notify_by_push")
  /// 短信通知开关
  notifyBySms       Boolean  @default(false) @map("notify_by_sms")
  /// 仪表盘配置
  dashboardSettings Json?    @map("dashboard_settings")
  /// 创建时间
  createdAt         DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([theme])
  @@map("user_preferences")
}

/// 用户审计信息表
model UserAudit {
  /// 审计记录ID
  id           String    @id @default(cuid())
  /// 用户ID
  userId       String    @unique @map("user_id")
  /// 创建人ID
  createdBy    String?   @map("created_by")
  /// 更新人ID
  updatedBy    String?   @map("updated_by")
  /// 最后登录时间
  lastLoginAt  DateTime? @map("last_login_at")
  /// 最后登录IP
  lastLoginIp  String?   @map("last_login_ip")
  /// 最后活跃时间
  lastActiveAt DateTime? @map("last_active_at")
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastLoginAt])
  @@index([lastActiveAt])
  @@map("user_audit")
}

/// 角色表
model Role {
  /// 角色ID
  id           String        @id @default(cuid())
  /// 角色编码
  code         String        @unique
  /// 角色名称
  name         String
  /// 角色描述
  description  String?
  /// 角色种类（system 不可改权限/删除）
  kind         RoleKind      @default(CUSTOM)
  /// 是否系统角色（兼容旧字段，与 kind=SYSTEM 同步）
  isSystem     Boolean       @default(false) @map("is_system")
  /// 角色状态
  status       RecordStatus  @default(ACTIVE)
  /// 过期时间，空表示长期有效
  expiresAt    DateTime?     @map("expires_at")
  /// 展示图标（Lucide 名）
  icon         String?
  /// 图标颜色 token
  iconColor    String?       @map("icon_color")
  /// 数据范围
  dataScope    RoleDataScope @default(SELF) @map("data_scope")
  /// CUSTOM 数据范围时的组织白名单
  customOrgIds String[]      @default([]) @map("custom_org_ids")
  /// 排序值
  sort         Int?
  /// 创建时间
  createdAt    DateTime      @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime      @updatedAt @map("updated_at")

  /// 角色下的用户关联
  users         UserRole[]
  /// 角色下的权限关联
  permissions   RolePermission[]
  /// 字段权限策略（预留）
  fieldPolicies RoleFieldPolicy[]

  @@index([status])
  @@index([kind])
  @@index([expiresAt])
  @@map("roles")
}

/// 组织表
model Organization {
  /// 组织ID
  id            String           @id @default(cuid())
  /// 组织编码
  code          String           @unique
  /// 组织名称
  name          String
  /// 组织类型
  type          OrganizationType @default(DEPARTMENT)
  /// 父组织ID
  parentId      String?          @map("parent_id")
  /// 负责人用户ID
  leaderId      String?          @map("leader_id")
  /// 组织描述
  description   String?
  /// 生效日期
  effectiveDate DateTime         @map("effective_date") @db.Date
  /// 层级路径（例如 /company/rd/backend）
  path          String?
  /// 层级深度
  level         Int              @default(1)
  /// 创建时间
  createdAt     DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt     DateTime         @updatedAt @map("updated_at")

  /// 父级组织
  parent    Organization?      @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  /// 子级组织
  children  Organization[]     @relation("OrganizationHierarchy")
  /// 负责人
  leader    User?              @relation("OrganizationLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  /// 组织岗位集合
  posts     Post[]
  /// 组织成员关联
  users     UserOrganization[]
  /// 演示便签（参考插件）
  demoNotes DemoNote[]
  /// 组织文件
  fileAssets FileAsset[]

  @@index([parentId])
  @@index([leaderId])
  @@index([type])
  @@index([path])
  @@map("organizations")
}

/// 岗位目录（全局可复用岗位标准）
model JobProfile {
  /// 岗位目录 ID
  id          String           @id @default(cuid())
  /// 岗位编码
  code        String           @unique
  /// 岗位名称
  name        String
  /// 岗位描述
  description String?
  /// 标准职级，例如 P7
  level       String
  /// 岗位族
  family      String?
  /// 展示图标（Lucide 名）
  icon         String?
  /// 图标颜色 token
  iconColor    String?          @map("icon_color")
  /// 启停状态
  status      JobProfileStatus @default(ACTIVE)
  /// 创建时间
  createdAt   DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime         @updatedAt @map("updated_at")

  /// 组织编制实例
  posts Post[]

  @@index([status])
  @@index([name])
  @@map("job_profiles")
}

/// 组织岗位编制表（组织对岗位目录的编制关联）
model Post {
  /// 编制 ID
  id             String                     @id @default(cuid())
  /// 岗位目录 ID
  jobProfileId   String                     @map("job_profile_id")
  /// 所属组织 ID
  organizationId String                     @map("organization_id")
  /// 组织侧补充说明
  description    String?
  /// 组织侧职级覆盖；为空时使用岗位目录职级
  level          String?
  /// 编制人数
  headcount      Int                        @default(1)
  /// 编制状态
  status         OrganizationPositionStatus @default(ACTIVE)
  /// 创建时间
  createdAt      DateTime                   @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  /// 所属岗位目录
  jobProfile   JobProfile         @relation(fields: [jobProfileId], references: [id], onDelete: Restrict)
  /// 所属组织
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 岗位任职用户
  users        UserOrganization[]

  @@unique([organizationId, jobProfileId])
  @@index([organizationId])
  @@index([jobProfileId])
  @@index([status])
  @@map("posts")
}

/// 用户组织岗位关联表
model UserOrganization {
  /// 用户ID
  userId         String    @map("user_id")
  /// 组织ID
  organizationId String    @map("organization_id")
  /// 岗位ID
  postId         String?   @map("post_id")
  /// 是否主任职
  isPrimary      Boolean   @default(false) @map("is_primary")
  /// 任职开始时间
  joinedAt       DateTime? @map("joined_at")
  /// 任职结束时间
  leftAt         DateTime? @map("left_at")
  /// 创建时间
  createdAt      DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联组织
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 关联岗位
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@index([postId])
  @@index([isPrimary])
  @@index([joinedAt])
  @@map("user_organizations")
}

/// 权限表
model Permission {
  /// 权限ID
  id          String           @id @default(cuid())
  /// 权限编码
  code        String           @unique
  /// 权限名称
  name        String
  /// 所属模块（展示分组）
  module      String?
  /// 资源段
  resource    String?
  /// 动作段
  action      String?
  /// 权限描述
  description String?
  /// 目录状态
  status      PermissionStatus @default(ACTIVE)
  /// 来源：kernel 或 plugin:<id>
  source      String?
  /// 创建时间
  createdAt   DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime         @updatedAt @map("updated_at")

  /// 权限对应的角色关联
  roles RolePermission[]

  @@index([module])
  @@index([status])
  @@map("permissions")
}

/// 角色字段权限策略（预留，本期无业务逻辑）
model RoleFieldPolicy {
  id        String      @id @default(cuid())
  roleId    String      @map("role_id")
  resource  String
  fieldKey  String      @map("field_key")
  access    FieldAccess @default(READ)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, fieldKey])
  @@index([roleId])
  @@map("role_field_policies")
}

/// 用户角色关联表
model UserRole {
  /// 用户ID
  userId    String   @map("user_id")
  /// 角色ID
  roleId    String   @map("role_id")
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// 角色权限关联表
model RolePermission {
  /// 角色ID
  roleId       String   @map("role_id")
  /// 权限ID
  permissionId String   @map("permission_id")
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")

  /// 关联角色
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// 关联权限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// 字典类型
model DictType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items DictItem[]

  @@map("dict_types")
}

/// 字典项
model DictItem {
  id        String       @id @default(cuid())
  typeCode  String       @map("type_code")
  label     String
  value     String
  sort      Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  type DictType @relation(fields: [typeCode], references: [code], onDelete: Cascade)

  @@unique([typeCode, value])
  @@index([typeCode, sort])
  @@map("dict_items")
}

/// 演示便签（参考插件 demo-notes）
model DemoNote {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  title          String
  content        String?
  createdBy      String    @map("created_by")
  updatedBy      String?   @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tenantId, organizationId])
  @@index([tenantId, createdBy])
  @@index([deletedAt])
  @@map("demo_notes")
}

/// 密码重置令牌
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// 登录事件历史（可按用户/时间查询）
model LoginEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  identifier String
  success    Boolean
  ip         String?
  userAgent  String?  @map("user_agent")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

/// 站内通知（notifications 插件）
model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default("cmtenant00000000000000001") @map("tenant_id")
  userId    String    @map("user_id")
  title     String
  body      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([createdAt])
  @@map("notifications")
}

/// 文件对象元数据（内核存储）
model FileAsset {
  id             String    @id @default(cuid())
  tenantId       String    @default("cmtenant00000000000000001") @map("tenant_id")
  ownerId        String    @map("owner_id")
  organizationId String?   @map("organization_id")
  purpose        String
  category       String    @default("other")
  status         String
  originalName   String    @map("original_name")
  declaredMime   String    @map("declared_mime")
  detectedMime   String?   @map("detected_mime")
  size           Int       @default(0)
  sha256         String?
  provider       String    @default("s3")
  storageKey     String    @map("storage_key")
  expiresAt      DateTime? @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  purgeAfter     DateTime? @map("purge_after")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions     UploadSession[]
  bindings     FileBinding[]

  @@index([tenantId, ownerId])
  @@index([tenantId, status])
  @@index([tenantId, purpose])
  @@index([tenantId, category])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([purgeAfter])
  @@index([sha256])
  @@map("file_assets")
}

/// 预签名上传会话
model UploadSession {
  id               String    @id @default(cuid())
  tenantId         String    @default("cmtenant00000000000000001") @map("tenant_id")
  fileId           String    @map("file_id")
  strategy         String    @default("presign_put")
  providerUploadId String?   @map("provider_upload_id")
  idempotencyKey   String?   @map("idempotency_key")
  status           String
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([fileId])
  @@index([expiresAt, status])
  @@map("upload_sessions")
}

/// 文件与业务资源绑定
model FileBinding {
  id           String   @id @default(cuid())
  tenantId     String   @default("cmtenant00000000000000001") @map("tenant_id")
  fileId       String   @map("file_id")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  relation     String
  createdAt    DateTime @default(now()) @map("created_at")

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, resourceType, resourceId, relation])
  @@index([tenantId, resourceType, resourceId])
  @@map("file_bindings")
}

/// 异步任务记录（jobs 插件）
model JobRecord {
  id         String    @id @default(cuid())
  tenantId   String    @default("cmtenant00000000000000001") @map("tenant_id")
  name       String
  status     String    @default("pending")
  payload    Json?
  result     Json?
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("job_records")
}
