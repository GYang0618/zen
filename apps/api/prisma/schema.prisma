generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 性别枚举
enum Gender {
  /// 男
  MALE    @map("male")
  /// 女
  FEMALE  @map("female")
  /// 未知
  UNKNOWN @map("unknown")
}

/// 多因子认证类型枚举
enum MfaType {
  /// TOTP 动态口令
  TOTP  @map("totp")
  /// 短信验证码
  SMS   @map("sms")
  /// 邮箱验证码
  EMAIL @map("email")
  /// 关闭多因子认证
  OFF   @map("off")
}

/// 主题模式枚举
enum Theme {
  /// 浅色模式
  LIGHT  @map("light")
  /// 深色模式
  DARK   @map("dark")
  /// 跟随系统
  SYSTEM @map("system")
}

/// 通用记录状态枚举
enum RecordStatus {
  /// 启用
  ACTIVE   @map("active")
  /// 禁用
  DISABLED @map("disabled")
}

/// 角色数据范围枚举
enum RoleDataScope {
  /// 全部数据
  ALL          @map("all")
  /// 组织及下级
  ORGANIZATION @map("organization")
  /// 仅本人数据
  SELF         @map("self")
  /// 自定义数据范围
  CUSTOM       @map("custom")
}

/// 用户账号状态枚举
enum UserStatusCode {
  /// 激活
  ACTIVE   @map("active")
  /// 未激活
  INACTIVE @map("inactive")
  /// 待审核
  PENDING  @map("pending")
  /// 已停用
  SUSPENDED @map("suspended")
}

/// 组织类型枚举
enum OrganizationType {
  /// 公司
  COMPANY    @map("company")
  /// 分支机构
  BRANCH     @map("branch")
  /// 部门
  DEPARTMENT @map("department")
  /// 小组
  TEAM       @map("team")
}

/// 用户主表
model User {
  /// 用户ID
  id                    String         @id @default(cuid())
  /// 用户名
  username              String         @unique
  /// 昵称
  nickname              String?
  /// 邮箱
  email                 String         @unique
  /// 手机号码
  phoneNumber           String?        @unique @map("phone_number")
  /// 密码哈希
  password              String
  /// Refresh Token 哈希（用于服务端撤销/轮换）
  refreshTokenHash      String?        @map("refresh_token_hash")
  /// Refresh Token 过期时间（服务端校验）
  refreshTokenExpiresAt DateTime?      @map("refresh_token_expires_at")
  /// 账号状态
  status                UserStatusCode @default(ACTIVE)
  /// 登录失败次数
  loginAttempts         Int            @default(0)
  /// 是否锁定
  isLocked              Boolean        @default(false)
  /// 锁定到期时间
  lockExpireAt          DateTime?
  /// 创建时间
  createdAt             DateTime       @default(now()) @map("created_at")
  /// 更新时间
  updatedAt             DateTime       @updatedAt @map("updated_at")
  /// 软删除时间（null 表示未删除）
  deletedAt             DateTime?      @map("deleted_at")

  /// 用户资料（一对一）
  profile     UserProfile?
  /// 用户安全设置（一对一）
  security    UserSecurity?
  /// 用户偏好设置（一对一）
  preference  UserPreference?
  /// 用户审计信息（一对一）
  audit       UserAudit?
  /// 用户角色关联（一对多）
  roles       UserRole[]
  /// 用户部门关联（一对多）
  departments UserDepartment[]
  /// 用户组织岗位关联（一对多）
  organizations UserOrganization[]
  /// 负责的组织集合（一对多）
  ledOrganizations Organization[] @relation("OrganizationLeader")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

/// 用户资料表
model UserProfile {
  /// 资料ID
  id        String   @id @default(cuid())
  /// 用户ID
  userId    String   @unique @map("user_id")
  /// 真实姓名
  realName  String?  @map("real_name")
  /// 头像地址
  avatar    String?
  /// 性别
  gender    Gender   @default(UNKNOWN)
  /// 职位名称
  jobTitle  String?  @map("job_title")
  /// 备注
  remark    String?
  /// 扩展元数据
  meta      Json?
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
  @@map("user_profiles")
}

/// 用户安全设置表
model UserSecurity {
  /// 安全记录ID
  id                 String    @id @default(cuid())
  /// 用户ID
  userId             String    @unique @map("user_id")
  /// 是否开启多因子认证
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  /// 多因子认证类型
  mfaType            MfaType   @default(OFF) @map("mfa_type")
  /// 密码到期时间
  passwordExpireAt   DateTime? @map("password_expire_at")
  /// 上次修改密码时间
  lastPasswordChange DateTime? @map("last_password_change")
  /// 创建时间
  createdAt          DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mfaEnabled])
  @@index([mfaType])
  @@map("user_security")
}

/// 用户偏好设置表
model UserPreference {
  /// 偏好记录ID
  id                String   @id @default(cuid())
  /// 用户ID
  userId            String   @unique @map("user_id")
  /// 语言区域
  locale            String   @default("zh-CN")
  /// 时区
  timezone          String   @default("Asia/Shanghai")
  /// 主题模式
  theme             Theme    @default(SYSTEM)
  /// 邮件通知开关
  notifyByEmail     Boolean  @default(true) @map("notify_by_email")
  /// 推送通知开关
  notifyByPush      Boolean  @default(true) @map("notify_by_push")
  /// 短信通知开关
  notifyBySms       Boolean  @default(false) @map("notify_by_sms")
  /// 仪表盘配置
  dashboardSettings Json?    @map("dashboard_settings")
  /// 创建时间
  createdAt         DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt         DateTime @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([theme])
  @@map("user_preferences")
}

/// 用户审计信息表
model UserAudit {
  /// 审计记录ID
  id           String    @id @default(cuid())
  /// 用户ID
  userId       String    @unique @map("user_id")
  /// 创建人ID
  createdBy    String?   @map("created_by")
  /// 更新人ID
  updatedBy    String?   @map("updated_by")
  /// 最后登录时间
  lastLoginAt  DateTime? @map("last_login_at")
  /// 最后登录IP
  lastLoginIp  String?   @map("last_login_ip")
  /// 最后活跃时间
  lastActiveAt DateTime? @map("last_active_at")
  /// 创建时间
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastLoginAt])
  @@index([lastActiveAt])
  @@map("user_audit")
}

/// 角色表
model Role {
  /// 角色ID
  id          String       @id @default(cuid())
  /// 角色编码
  code        String       @unique
  /// 角色名称
  name        String
  /// 角色描述
  description String?
  /// 是否系统角色
  isSystem    Boolean      @default(false) @map("is_system")
  /// 角色状态
  status      RecordStatus @default(ACTIVE)
  /// 数据范围
  dataScope   RoleDataScope @default(SELF) @map("data_scope")
  /// 排序值
  sort        Int?
  /// 创建时间
  createdAt   DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime     @updatedAt @map("updated_at")

  /// 角色下的用户关联
  users       UserRole[]
  /// 角色下的权限关联
  permissions RolePermission[]

  @@index([status])
  @@map("roles")
}

/// 组织表
model Organization {
  /// 组织ID
  id          String           @id @default(cuid())
  /// 组织编码
  code        String           @unique
  /// 组织名称
  name        String
  /// 组织类型
  type        OrganizationType @default(DEPARTMENT)
  /// 父组织ID
  parentId    String?          @map("parent_id")
  /// 负责人用户ID
  leaderId    String?          @map("leader_id")
  /// 组织描述
  description String?
  /// 状态
  status      RecordStatus     @default(ACTIVE)
  /// 排序值
  sort        Int?
  /// 层级路径（例如 /company/rd/backend）
  path        String?
  /// 层级深度
  level       Int              @default(1)
  /// 创建时间
  createdAt   DateTime         @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime         @updatedAt @map("updated_at")

  /// 父级组织
  parent   Organization?   @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  /// 子级组织
  children Organization[]  @relation("OrganizationHierarchy")
  /// 负责人
  leader   User?           @relation("OrganizationLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  /// 组织岗位集合
  posts    Post[]
  /// 组织成员关联
  users    UserOrganization[]

  @@index([parentId])
  @@index([leaderId])
  @@index([type])
  @@index([status])
  @@index([path])
  @@map("organizations")
}

/// 岗位表
model Post {
  /// 岗位ID
  id             String       @id @default(cuid())
  /// 岗位编码
  code           String       @unique
  /// 岗位名称
  name           String
  /// 所属组织ID
  organizationId String       @map("organization_id")
  /// 岗位描述
  description    String?
  /// 状态
  status         RecordStatus @default(ACTIVE)
  /// 排序值
  sort           Int?
  /// 创建时间
  createdAt      DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime     @updatedAt @map("updated_at")

  /// 所属组织
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 岗位任职用户
  users        UserOrganization[]

  @@index([organizationId])
  @@index([status])
  @@map("posts")
}

/// 用户组织岗位关联表
model UserOrganization {
  /// 用户ID
  userId         String    @map("user_id")
  /// 组织ID
  organizationId String    @map("organization_id")
  /// 岗位ID
  postId         String?   @map("post_id")
  /// 是否主任职
  isPrimary      Boolean   @default(false) @map("is_primary")
  /// 任职开始时间
  joinedAt       DateTime? @map("joined_at")
  /// 任职结束时间
  leftAt         DateTime? @map("left_at")
  /// 创建时间
  createdAt      DateTime  @default(now()) @map("created_at")
  /// 更新时间
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// 关联用户
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联组织
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 关联岗位
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@index([postId])
  @@index([isPrimary])
  @@index([joinedAt])
  @@map("user_organizations")
}

/// 权限表
model Permission {
  /// 权限ID
  id          String   @id @default(cuid())
  /// 权限编码
  code        String   @unique
  /// 权限名称
  name        String
  /// 所属模块
  module      String?
  /// 权限描述
  description String?
  /// 创建时间
  createdAt   DateTime @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// 权限对应的角色关联
  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// 用户角色关联表
model UserRole {
  /// 用户ID
  userId    String   @map("user_id")
  /// 角色ID
  roleId    String   @map("role_id")
  /// 创建时间
  createdAt DateTime @default(now()) @map("created_at")

  /// 关联用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// 角色权限关联表
model RolePermission {
  /// 角色ID
  roleId       String   @map("role_id")
  /// 权限ID
  permissionId String   @map("permission_id")
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")

  /// 关联角色
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// 关联权限
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// 部门表
model Department {
  /// 部门ID
  id          String       @id @default(cuid())
  /// 部门编码
  code        String       @unique
  /// 部门名称
  name        String
  /// 父部门ID
  parentId    String?      @map("parent_id")
  /// 部门描述
  description String?
  /// 部门状态
  status      RecordStatus @default(ACTIVE)
  /// 排序值
  sort        Int?
  /// 创建时间
  createdAt   DateTime     @default(now()) @map("created_at")
  /// 更新时间
  updatedAt   DateTime     @updatedAt @map("updated_at")

  /// 父级部门
  parent   Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  /// 子部门集合
  children Department[]     @relation("DepartmentHierarchy")
  /// 部门下的用户关联
  users    UserDepartment[]

  @@index([parentId])
  @@index([status])
  @@map("departments")
}

/// 用户部门关联表
model UserDepartment {
  /// 用户ID
  userId       String   @map("user_id")
  /// 部门ID
  departmentId String   @map("department_id")
  /// 是否主部门
  isPrimary    Boolean  @default(false) @map("is_primary")
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")

  /// 关联用户
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联部门
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}
