# ==================== 环境变量示例 ====================
# 复制为 .env，或按环境复制为 .env.development / .env.test / .env.production
# ConfigModule 加载顺序：.env.${NODE_ENV} → .env（后者覆盖前者）
# Nest 校验见 src/config/env.schema.ts；OPENAI_* / LANGSMITH_* 由 LangChain 运行时读取，不进 Nest schema
# LANGGRAPH_DEPLOYMENT_URL 会进入 Nest schema（Copilot 连接 Agent）

# ==================== 应用配置 ====================
## 运行环境：development | production | test
NODE_ENV=development

## 应用名称
APP_NAME=Admin

## 应用监听端口（本地默认 3100，避免与 web:3000 冲突）
PORT=3100

## API 全局前缀
API_PREFIX=/api

# ==================== 数据库配置 ====================
## PostgreSQL 连接字符串（宿主机连 zen-postgres 映射端口）
DATABASE_URL=postgresql://admin:admin123@localhost:5432/admin_dev?schema=public

# ==================== JWT 认证配置 ====================
## JWT 签名密钥（至少 32 字符；生产环境请使用强随机密钥）
JWT_SECRET=your-jwt-secret-key-at-least-32-chars-long

## Access Token 过期时间（数字 + s|m|h|d）
JWT_EXPIRES_IN=15m

## Refresh Token 过期时间
JWT_REFRESH_EXPIRES_IN=7d

# ==================== 日志配置 ====================
## 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# ==================== CORS 配置 ====================
## 允许的跨域源（* 或逗号分隔列表；生产环境勿用 *）
CORS_ORIGIN=http://localhost:3000

# ==================== 限流配置 ====================
## 限流窗口期（毫秒）
THROTTLE_TTL=60000

## 窗口内最大请求数
THROTTLE_LIMIT=10

## Copilot 独立限流窗口期（毫秒）
COPILOT_THROTTLE_TTL=60000

## Copilot 独立限流窗口内最大请求数
COPILOT_THROTTLE_LIMIT=60

# ==================== Swagger 配置 ====================
## 是否启用 Swagger
SWAGGER_ENABLED=true

## Swagger 访问路径（最终为 /{API_PREFIX}/{SWAGGER_PATH}）
SWAGGER_PATH=docs

## 启动时导出的 OpenAPI JSON（相对 apps/api 工作目录）
SWAGGER_JSON_OUTPUT=swagger.json

# ==================== LangGraph / Copilot ====================
## LangGraph Agent 服务地址（与 apps/agent `langgraphjs dev --host 127.0.0.1 --port 3600` 对齐）
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:3600

# ==================== AI 配置（LangChain / Chat；可选） ====================
## OpenAI 兼容端点（如阿里云 DashScope）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-***your-api-key***

## LangSmith 追踪（可选）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_***your-api-key***
LANGSMITH_PROJECT=study
# 注：OPENAI_* / LANGSMITH_* 由 LangChain 运行时读取，不进 Nest env.schema

# ==================== 对象存储（MinIO / S3 兼容） ====================
## 宿主机连 zen-minio 映射端口；Compose 内 API 使用 http://zen-minio:9000
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=zen-files
STORAGE_ACCESS_KEY=zen
STORAGE_SECRET_KEY=zenminio_secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL=300
STORAGE_DOWNLOAD_URL_TTL=300
