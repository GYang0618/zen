{
  "name": "zen",
  "private": true,
  "scripts": {
    "web": "pnpm -F web dev",
    "api": "pnpm -F api dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "docs:check-links": "node scripts/check-docs-links.mjs",
    "plugin:validate": "pnpm -F @zen/plugin-sdk build && pnpm -F @zen/plugin-sdk validate",
    "plugin:generate": "pnpm -F @zen/plugin-sdk build && pnpm -F @zen/plugin-sdk generate && pnpm -F @zen/plugin-sdk build",
    "plugin:create": "node scripts/create-plugin.mjs",
    "clean": "pnpm run clean:dist && pnpm run clean:modules",
    "clean:dist": "pnpm -r --parallel exec rimraf -rf dist",
    "clean:modules": "pnpm -r --parallel exec rimraf -rf node_modules && rimraf -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "fastify": "5.8.5",
      "hono": "^4.12.18",
      "three-mesh-bvh": "0.9.10"
    }
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  }
}
