{
  "name": "@zen/plugin-demo-notes",
  "version": "0.1.0",
  "private": true,
  "description": "演示便签参考插件",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    },
    "./config": {
      "types": "./dist/config.schema.d.ts",
      "default": "./dist/config.schema.js"
    }
  },
  "files": [
    "dist",
    "src/web",
    "zen.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@zen/plugin-sdk": "workspace:*",
    "@zen/shared": "workspace:*",
    "@zen/ui": "workspace:*",
    "lucide-react": "^1.27.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@zen/ui": "workspace:*",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^7.9.0",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
